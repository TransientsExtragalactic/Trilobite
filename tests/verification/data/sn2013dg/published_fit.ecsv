# %ECSV 1.0
# ---
# datatype:
# - {name: name, datatype: string}
# - {name: value, datatype: float64}
# - {name: err_up, datatype: float64}
# - {name: err_down, datatype: float64}
# - {name: unit, datatype: string}
# - {name: description, datatype: string}
# meta: !!omap
# - {source: 'Nicholl et al. 2017, ApJ 850, 55 (arXiv:1706.00825), SN 2013dg row of the table of fit parameters (medians and 1-sigma ranges)'}
# - {redshift_source: Nicholl et al. 2014}
# schema: astropy-2.0
name value err_up err_down unit description
P 3.5 0.6 0.59 ms "initial spin period"
B_perp 1.56 0.41 0.32 "1e14 G" "magnetic field perpendicular to the spin axis"
M_ej 2.75 1.63 0.99 Msun "ejecta mass"
v_phot 8.38 0.44 0.51 "1e3 km/s" "photospheric velocity"
kappa 0.12 0.06 0.04 "cm2 / g" "optical opacity"
kappa_gamma 0.04 0.02 0.02 "cm2 / g" "opacity to high-energy photons"
M_NS 1.8 0.22 0.21 Msun "neutron-star mass"
T_floor 5.07 0.23 0.31 "1e3 K" "photospheric temperature floor"
A_V 0.07 0.1 0.06 mag "host extinction"
sigma 0.01 0.02 0.01 mag "extra variance that gives a reduced chi-squared of 1"
